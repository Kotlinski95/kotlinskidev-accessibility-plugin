#: src/php/I18n/Strings.php:57
msgid "Bigger text"
msgstr "Powiększ tekst"

#: src/php/I18n/Strings.php:58
msgid "Increase the text size across the page."
msgstr "Zwiększa rozmiar tekstu na całej stronie."

#: src/php/I18n/Strings.php:59
msgid "Line height"
msgstr "Wysokość linii"

#: src/php/I18n/Strings.php:60
msgid "Increase the space between lines of text."
msgstr "Zwiększa odstępy między wierszami tekstu."

#: src/php/I18n/Strings.php:61
msgid "Letter spacing"
msgstr "Odstępy między literami"

#: src/php/I18n/Strings.php:62
msgid "Increase the space between letters."
msgstr "Zwiększa odstępy między literami."

#: src/php/I18n/Strings.php:63
msgid "Font weight"
msgstr "Grubość czcionki"

#: src/php/I18n/Strings.php:64
msgid "Make text bolder."
msgstr "Pogrubia tekst."

#: src/php/I18n/Strings.php:65
msgid "Readable font"
msgstr "Czytelna czcionka"

#: src/php/I18n/Strings.php:66
msgid "Switch to a plain, easy-to-read font."
msgstr "Przełącza na prostą, łatwą do czytania czcionkę."

#: src/php/I18n/Strings.php:67
msgid "Dyslexia-friendly font"
msgstr "Czcionka przyjazna dyslektykom"

#: src/php/I18n/Strings.php:68
msgid "Use a font designed to ease reading with dyslexia."
msgstr "Używa czcionki zaprojektowanej z myślą o ułatwieniu czytania osobom z dysleksją."

#: src/php/I18n/Strings.php:69
msgid "Text alignment"
msgstr "Wyrównanie tekstu"

#: src/php/I18n/Strings.php:70
msgid "Cycle text alignment between left, center and right."
msgstr "Przełącza wyrównanie tekstu: do lewej, do środka i do prawej."

#: src/php/I18n/Strings.php:71
msgid "Highlight links"
msgstr "Wyróżnij linki"

#: src/php/I18n/Strings.php:72
msgid "Underline and emphasize every link."
msgstr "Podkreśla i wyróżnia każdy link."

#: src/php/I18n/Strings.php:73
msgid "Big cursor"
msgstr "Duży kursor"

#: src/php/I18n/Strings.php:74
msgid "Enlarge the mouse pointer."
msgstr "Powiększa wskaźnik myszy."

#: src/php/I18n/Strings.php:75
msgid "Text magnifier"
msgstr "Lupa tekstu"

#: src/php/I18n/Strings.php:76
msgid "Show a magnified view of the text under the pointer."
msgstr "Pokazuje powiększony podgląd tekstu pod wskaźnikiem."

#: src/php/I18n/Strings.php:77
msgid "Cognitive reading"
msgstr "Czytanie wspomagane"

#: src/php/I18n/Strings.php:78
msgid "Bold the first half of each word to guide reading."
msgstr "Pogrubia pierwszą połowę każdego słowa, aby prowadzić wzrok podczas czytania."

#: src/php/I18n/Strings.php:79
msgid "Dark contrast"
msgstr "Ciemny kontrast"

#: src/php/I18n/Strings.php:80
msgid "Use a dark, high-legibility color scheme."
msgstr "Używa ciemnej, bardzo czytelnej kolorystyki."

#: src/php/I18n/Strings.php:81
msgid "Light contrast"
msgstr "Jasny kontrast"

#: src/php/I18n/Strings.php:82
msgid "Use a light, high-legibility color scheme."
msgstr "Używa jasnej, bardzo czytelnej kolorystyki."

#: src/php/I18n/Strings.php:83
msgid "High contrast"
msgstr "Wysoki kontrast"

#: src/php/I18n/Strings.php:84
msgid "Increase the contrast of all colors."
msgstr "Zwiększa kontrast wszystkich kolorów."

#: src/php/I18n/Strings.php:85
msgid "Monochrome"
msgstr "Tryb monochromatyczny"

#: src/php/I18n/Strings.php:86
msgid "Remove all color from the page."
msgstr "Usuwa wszystkie kolory ze strony."

#: src/php/I18n/Strings.php:87
msgid "Saturation"
msgstr "Nasycenie"

#: src/php/I18n/Strings.php:88
msgid "Lower or raise the color saturation."
msgstr "Zmniejsza lub zwiększa nasycenie kolorów."

#: src/php/I18n/Strings.php:89
msgid "Reading line"
msgstr "Linia czytania"

#: src/php/I18n/Strings.php:90
msgid "Show a horizontal guide line that follows the pointer."
msgstr "Pokazuje poziomą linię pomocniczą podążającą za wskaźnikiem."

#: src/php/I18n/Strings.php:91
msgid "Reading mask"
msgstr "Maska czytania"

#: src/php/I18n/Strings.php:92
msgid "Dim everything except the line being read."
msgstr "Przyciemnia wszystko poza czytaną linią."

#: src/php/I18n/Strings.php:93
msgid "Read page"
msgstr "Czytnik strony"

#: src/php/I18n/Strings.php:94
msgid "Read the page content aloud."
msgstr "Odczytuje treść strony na głos."

#: src/php/I18n/Strings.php:95
msgid "Keyboard navigation"
msgstr "Nawigacja klawiaturą"

#: src/php/I18n/Strings.php:96
msgid "Strengthen focus outlines and enable navigation hotkeys."
msgstr "Wzmacnia obrys fokusu i włącza skróty klawiszowe do nawigacji."

#: src/php/I18n/Strings.php:97
msgid "Hide images"
msgstr "Ukryj obrazy"

#: src/php/I18n/Strings.php:98
msgid "Hide all images on the page."
msgstr "Ukrywa wszystkie obrazy na stronie."

#: src/php/I18n/Strings.php:99
msgid "Mute sounds"
msgstr "Wycisz dźwięki"

#: src/php/I18n/Strings.php:100
msgid "Mute all audio and video on the page."
msgstr "Wycisza wszystkie dźwięki i filmy na stronie."

#: src/php/I18n/Strings.php:101
msgid "Highlight titles"
msgstr "Wyróżnij nagłówki"

#: src/php/I18n/Strings.php:102
msgid "Outline every heading on the page."
msgstr "Obramowuje każdy nagłówek na stronie."

#: src/php/I18n/Strings.php:103
msgid "Highlight all"
msgstr "Wyróżnij wszystko"

#: src/php/I18n/Strings.php:104
msgid "Outline all interactive elements and headings."
msgstr "Obramowuje wszystkie elementy interaktywne i nagłówki."

#: src/php/I18n/Strings.php:105
msgid "Stop animations"
msgstr "Zatrzymaj animacje"

#: src/php/I18n/Strings.php:106
msgid "Stop animations, moving images and autoplay video."
msgstr "Zatrzymuje animacje, ruchome obrazy i automatycznie odtwarzane filmy."

#: src/php/I18n/Strings.php:107
msgid "Skip to content"
msgstr "Pomiń do treści"

#: src/php/I18n/Strings.php:108
msgid "Jump straight to a main part of the page."
msgstr "Przechodzi bezpośrednio do wybranej części strony."

#: src/php/I18n/Strings.php:109
msgid "Vision impaired"
msgstr "Osoby słabowidzące"

#: src/php/I18n/Strings.php:110
msgid "Seizure safe"
msgstr "Bezpieczne dla osób z napadami"

#: src/php/I18n/Strings.php:111
msgid "ADHD friendly"
msgstr "Przyjazne dla osób z ADHD"

#: src/php/I18n/Strings.php:112
msgid "Blindness"
msgstr "Osoby niewidome"

#: src/php/I18n/Strings.php:113
msgid "Epilepsy safe"
msgstr "Bezpieczne dla osób z padaczką"

