#: src/php/I18n/Strings.php:146
msgid "The accessibility statement has not been published yet."
msgstr "Deklaracja dostępności nie została jeszcze opublikowana."

#: src/php/I18n/Strings.php:147
msgid "Our commitment to accessibility"
msgstr "Nasze zobowiązanie do zapewnienia dostępności"

#: src/php/I18n/Strings.php:148
msgid "We want this website to be usable by everyone, including people with disabilities."
msgstr "Chcemy, aby ta strona była dostępna dla wszystkich, w tym dla osób z niepełnosprawnościami."

#: src/php/I18n/Strings.php:149
msgid "Conformance status"
msgstr "Status zgodności"

#: src/php/I18n/Strings.php:150
msgid "We are working towards conformance with WCAG 2.2 level AA."
msgstr "Dążymy do zgodności ze standardem WCAG 2.2 na poziomie AA."

#: src/php/I18n/Strings.php:151
msgid "Feedback and contact"
msgstr "Opinie i kontakt"

#: src/php/I18n/Strings.php:152
msgid "If you run into an accessibility barrier on this website, please contact the site owner and describe the problem."
msgstr "Jeśli napotkasz na tej stronie barierę dostępności, skontaktuj się z właścicielem witryny i opisz problem."

#: src/php/I18n/Strings.php:153
msgid "Date of this statement"
msgstr "Data sporządzenia deklaracji"

#: src/php/I18n/Strings.php:154
msgid "This statement is reviewed regularly; the date of the last review is added by the site owner."
msgstr "Deklaracja jest regularnie przeglądana; datę ostatniego przeglądu dodaje właściciel witryny."

