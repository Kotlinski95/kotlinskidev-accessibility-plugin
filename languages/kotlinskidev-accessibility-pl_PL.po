msgstr "Włącz skrót klawiszowy"

#: build/admin.js:1
msgid "Shortcut combination"
msgstr "Kombinacja skrótu"

#: build/admin.js:1
msgid "Opens the accessibility panel from anywhere on the page."
msgstr "Otwiera panel dostępności z dowolnego miejsca na stronie."

#: build/admin.js:1
msgid "Let visitors hide the toolbar"
msgstr "Pozwól odwiedzającym ukrywać pasek narzędzi"

