msgstr "Dane panelu są serwowane jako pliki statyczne."

#: src/php/Health/Checks.php:239
msgid "Panel data folder is not writable"
msgstr "Folder danych panelu nie jest zapisywalny"

#: src/php/Health/Checks.php:240
msgid ""
"The uploads folder kotlinskidev-a11y cannot be written, so panel data falls "
"back to the REST API."
msgstr ""
"Do folderu kotlinskidev-a11y w uploads nie można zapisywać, więc dane panelu "
"są pobierane przez REST API."

#: src/php/Health/Checks.php:248
