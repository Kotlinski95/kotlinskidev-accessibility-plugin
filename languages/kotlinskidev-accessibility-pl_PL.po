msgid "Detected without a matching opt-out:"
msgstr "Wykryto bez odpowiedniego wyłączenia:"

#: src/php/Health/Checks.php:172
msgid ""
"Use the compatibility performance preset, or the custom preset with the "
"matching opt-out."
msgstr ""
"Użyj presetu wydajności Zgodność albo presetu własnego z odpowiednim "
"wyłączeniem."

#: src/php/Health/Checks.php:181
msgid "Autoptimize may aggregate the accessibility widget scripts"
msgstr "Autoptimize może łączyć skrypty widżetu dostępności"

#: src/php/Health/Checks.php:182
msgid ""
"Exclude kotlinskidev-accessibility scripts from Autoptimize aggregation."
msgstr "Wyklucz skrypty kotlinskidev-accessibility z łączenia w Autoptimize."

