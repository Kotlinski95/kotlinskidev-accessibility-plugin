parameters:
    level: 8
    paths:
        - src/php
        - uninstall.php
    scanFiles:
        - kotlinskidev-accessibility.php
        - tests/php/Cli/WpCliStub.php
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        -
            identifier: missingType.iterableValue
