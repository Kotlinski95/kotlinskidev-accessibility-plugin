{
  "name": "kotlinskidev-accessibility",
  "version": "1.0.0-beta.1",
  "private": true,
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node bin/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "i18n:pot": "wp i18n make-pot . languages/kotlinskidev-accessibility.pot --include=src/php,build",
    "i18n:json": "wp i18n make-json languages --no-purge && node bin/fix-i18n-json.mjs",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/ts/**/*.ts\" \"tests/js/**/*.ts\" \"tests/e2e/**/*.ts\" playwright.config.ts",
    "check-budget": "node bin/check-budget.mjs",
    "check-scss-scope": "node bin/check-scss-scope.mjs",
    "check-version": "node bin/check-version.mjs",
    "release": "node bin/release.mjs",
    "wp-env:start": "wp-env start",
    "wp-env:stop": "wp-env stop",
    "wp-env:multisite:start": "node bin/multisite-env.mjs start",
    "wp-env:multisite:stop": "node bin/multisite-env.mjs stop",
    "test:e2e": "playwright test",
    "test:e2e:multisite": "KA11Y_MULTISITE=1 playwright test --project=multisite"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "^1.65.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^26.6.6",
    "@wordpress/env": "^12.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "sass": "^1.80.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
