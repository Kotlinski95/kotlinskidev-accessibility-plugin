{
  "name": "kotlinskidev-accessibility",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node bin/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "i18n:pot": "wp i18n make-pot . languages/kotlinskidev-accessibility.pot --include=src/php,build",
    "i18n:json": "wp i18n make-json languages --no-purge",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/ts/**/*.ts\" \"tests/js/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/jest": "^29.5.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "sass": "^1.80.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
